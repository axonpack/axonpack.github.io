---
import Icon from "@/components/ui/icon.ui.astro";
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Switch theme"
  class="grid size-9 place-items-center rounded-lg border text-muted-foreground hover:text-foreground"
>
  <Icon name="sun" class="size-4" data-theme-light />
  <Icon name="moon" class="hidden size-4" data-theme-dark />
</button>

<script>
  // The stylesheet already understands three states: html.dark, html.light, and no class meaning
  // "follow the system". The button only ever writes an explicit choice, so a visitor who never
  // touches it keeps following their OS.
  const button = document.getElementById("theme-toggle")!;
  const root = document.documentElement;

  const isDark = () =>
    root.classList.contains("dark") ||
    (!root.classList.contains("light") && matchMedia("(prefers-color-scheme: dark)").matches);

  const paint = () => {
    const dark = isDark();
    button.querySelector("[data-theme-light]")!.classList.toggle("hidden", dark);
    button.querySelector("[data-theme-dark]")!.classList.toggle("hidden", !dark);
    button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
  };

  button.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.classList.remove("light", "dark");
    root.classList.add(next);
    try {
      localStorage.setItem("axonpack-theme", next);
    } catch {
      // Private windows can throw on write; the choice just won't survive a reload.
    }
    paint();
  });

  // Follow the OS while no explicit choice is stored.
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    if (!root.classList.contains("light") && !root.classList.contains("dark")) paint();
  });

  paint();
</script>
