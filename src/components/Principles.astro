---
import Icon from "@/components/Icon.astro";
import { content } from "@/lib/content";
---

<section class="px-5 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-balance text-[clamp(1.75rem,1.3rem+1.6vw,2.5rem)] font-[620] leading-tight tracking-tight">
        {content.principles.title}
      </h2>
      <p class="mt-4 text-pretty text-muted-foreground">{content.principles.body}</p>
    </div>
    <div class="mt-14 grid gap-5 md:grid-cols-2">
      {
        content.principles.items.map((item) => (
          <div class="rounded-lg border bg-card bg-gradient-to-b from-secondary/50 to-transparent p-6">
            <Icon name={item.icon} class="size-5 text-accent" />
            <h3 class="mb-1.5 mt-4 text-[1.0625rem] font-semibold tracking-tight">{item.title}</h3>
            <p class="text-sm text-muted-foreground">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
