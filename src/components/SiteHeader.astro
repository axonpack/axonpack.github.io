---
import Icon from "@/components/Icon.astro";
import { content, navLink } from "@/lib/content";
import { packages, stars } from "@/lib/packages";

const docs = navLink("Docs");
const community = navLink("Community");
const compact = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, "")}K` : `${n}`);

const linkClass =
  "flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm text-muted-foreground hover:bg-secondary hover:text-foreground max-lg:justify-between max-lg:text-base";
const panelClass =
  "absolute left-1/2 top-[calc(100%+10px)] flex -translate-x-1/2 gap-7 rounded-lg border bg-popover p-4 shadow-2xl before:absolute before:inset-x-0 before:-top-2.5 before:h-2.5 max-lg:static max-lg:translate-x-0 max-lg:flex-col max-lg:gap-3 max-lg:border-0 max-lg:p-0 max-lg:pl-2 max-lg:shadow-none";
---

<header id="site-header" class="sticky top-0 z-50 border-b border-transparent bg-background transition-colors">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center gap-6 px-5">
    <a href="/" class="flex shrink-0 items-center gap-2 text-[1.0625rem] font-bold tracking-tight">
      <picture>
        <source srcset="/assets/logo-dark.png" media="(prefers-color-scheme: dark)" />
        <img src="/assets/logo.png" alt="" width="26" height="26" />
      </picture>
      {content.brand.name}
    </a>

    <nav
      id="site-nav"
      class="flex items-center gap-0.5 max-lg:fixed max-lg:inset-x-0 max-lg:top-16 max-lg:hidden max-lg:max-h-[calc(100dvh-4rem)] max-lg:flex-col max-lg:items-stretch max-lg:overflow-y-auto max-lg:border-b max-lg:bg-background max-lg:px-5 max-lg:pb-6"
    >
      <a href={docs?.href ?? "/docs/"} class={linkClass}>
        Docs
        <Icon name="arrow-up-right" class="size-3.5 stroke-2 text-subtle" />
      </a>

      <div class="relative max-lg:static" data-menu>
        <button type="button" class={linkClass} aria-expanded="false" aria-controls="menu-packages">
          <span>Packages</span>
          <Icon name="chevron-down" class="size-3.5 stroke-2 text-subtle transition-transform" data-chev />
        </button>
        <div id="menu-packages" class={panelClass} hidden>
          <div class="min-w-64">
            <h3 class="mb-1 ml-2 text-[0.6875rem] font-semibold uppercase tracking-wider text-subtle">
              Published
            </h3>
            {
              packages.map((pkg) => (
                <a href={pkg.docsHref} class="block rounded-lg p-2 hover:bg-secondary">
                  <span class="flex items-center gap-2 font-mono text-sm">
                    {pkg.name}
                    <span class="rounded-full border bg-secondary px-2 py-0.5 font-mono text-[0.7rem] text-subtle">
                      v{pkg.version}
                    </span>
                  </span>
                  <span class="mt-0.5 block text-xs text-subtle">{pkg.description}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      {
        community?.menu && (
          <div class="relative max-lg:static" data-menu>
            <button type="button" class={linkClass} aria-expanded="false" aria-controls="menu-community">
              <span>Community</span>
              <Icon name="chevron-down" class="size-3.5 stroke-2 text-subtle transition-transform" data-chev />
            </button>
            <div id="menu-community" class={panelClass} hidden>
              {community.menu.map((group) => (
                <div class="min-w-44">
                  <h3 class="mb-1 ml-2 text-[0.6875rem] font-semibold uppercase tracking-wider text-subtle">
                    {group.title}
                  </h3>
                  {group.items.map((item) => (
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noreferrer noopener"
                      class="block rounded-lg p-2 text-sm hover:bg-secondary hover:text-accent"
                    >
                      {item.label}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        )
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        href={content.nav.github.href}
        target="_blank"
        rel="noreferrer noopener"
        aria-label={`Star ${content.nav.github.repo} on GitHub`}
        class="inline-flex h-9 items-center gap-1.5 rounded-full bg-primary px-3 text-[0.8125rem] font-semibold text-primary-foreground transition-opacity hover:opacity-85"
      >
        <Icon name="github" class="size-4" />
        {
          stars !== null && (
            <span class="inline-flex items-center gap-1 tabular-nums">
              {compact(stars)}
              <Icon name="star" class="size-3.5 stroke-2" />
            </span>
          )
        }
      </a>
      <button
        id="nav-burger"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-nav"
        class="grid size-9 place-items-center rounded-lg border text-muted-foreground hover:text-foreground lg:hidden"
      >
        <Icon name="menu" class="size-4" data-burger-open />
        <Icon name="close" class="hidden size-4" data-burger-close />
      </button>
    </div>
  </div>
</header>

<script>
  // Vanilla rather than a React island: this is the whole reason the page shipped 65 kB of React
  // runtime for two interactions. Astro bundles and minifies this to a couple hundred bytes.
  const header = document.getElementById("site-header")!;
  const nav = document.getElementById("site-nav")!;
  const burger = document.getElementById("nav-burger")!;
  const triggers = [...header.querySelectorAll<HTMLButtonElement>("[data-menu] > button")];
  const desktop = matchMedia("(min-width: 1024px)");

  const setMenu = (trigger: HTMLButtonElement, open: boolean) => {
    trigger.setAttribute("aria-expanded", String(open));
    document.getElementById(trigger.getAttribute("aria-controls")!)!.hidden = !open;
    trigger.querySelector("[data-chev]")?.classList.toggle("rotate-180", open);
  };
  const closeMenus = (keep?: HTMLButtonElement) => {
    for (const t of triggers) if (t !== keep) setMenu(t, false);
  };
  const setDrawer = (open: boolean) => {
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    nav.classList.toggle("max-lg:hidden", !open);
    nav.classList.toggle("max-lg:flex", open);
    burger.querySelector("[data-burger-open]")!.classList.toggle("hidden", open);
    burger.querySelector("[data-burger-close]")!.classList.toggle("hidden", !open);
    document.body.style.overflow = open ? "hidden" : "";
  };

  header.addEventListener("click", (event) => {
    const trigger = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-menu] > button");
    if (!trigger) return;
    const open = trigger.getAttribute("aria-expanded") === "false";
    closeMenus(trigger);
    setMenu(trigger, open);
  });

  // Hover opens on desktop; touch and the drawer both go through the click handler above.
  header.addEventListener("pointerover", (event) => {
    if (!desktop.matches || event.pointerType === "touch") return;
    const trigger = (event.target as HTMLElement)
      .closest("[data-menu]")
      ?.querySelector<HTMLButtonElement>("button");
    closeMenus(trigger ?? undefined);
    if (trigger) setMenu(trigger, true);
  });
  header.addEventListener("pointerleave", () => desktop.matches && closeMenus());

  burger.addEventListener("click", () => setDrawer(burger.getAttribute("aria-expanded") === "false"));
  // Crossing the breakpoint with the drawer open would strand the body scroll lock.
  desktop.addEventListener("change", () => {
    setDrawer(false);
    closeMenus();
  });

  document.addEventListener("click", (event) => {
    if (!(event.target as HTMLElement).closest("#site-header")) closeMenus();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    closeMenus();
    setDrawer(false);
  });

  const markScrolled = () =>
    header.classList.toggle("border-transparent", window.scrollY <= 4);
  addEventListener("scroll", markScrolled, { passive: true });
  markScrolled();
</script>
