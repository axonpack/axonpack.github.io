---
import BaseLayout from "@/layouts/base.layout.astro";
import SiteHeader from "@/components/site-header.component.astro";
import SiteFooter from "@/components/site-footer.component.astro";
import Icon from "@/components/ui/icon.ui.astro";
import { inlineMd } from "@/lib/utils/inline-md.util";
import { getReleases } from "@/lib/services/blog-entries.service";
import { formatDate } from "@/lib/utils/format-date.util";
import { BUMP_STYLES } from "@/lib/constants/bump-styles.const";

const releases = getReleases();
---

<BaseLayout
  title="Changelog · Axonpack Open Source"
  description="Every release of every Axonpack library, generated from the changelog each package publishes to npm."
>
  <SiteHeader />
  <main class="px-5 py-20">
    <div class="mx-auto max-w-3xl">
      <a href="/blog/" class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-accent">
        <Icon name="arrow-right" class="size-3.5 rotate-180" /> Blog
      </a>
      <h1 class="mt-8 text-[clamp(2rem,1.4rem+2vw,3rem)] font-[640] leading-tight tracking-[-0.03em]">
        Changelog
      </h1>
      <p class="mt-4 text-pretty text-muted-foreground">
        Every release of every library. Nobody writes these entries. Each one is the changelog the
        package published to npm, so what shipped and what you read here cannot drift apart.
      </p>

      {releases.length === 0 && <p class="mt-12 text-muted-foreground">No releases yet.</p>}

      <ol class="mt-12 space-y-4">
        {
          releases.map((release) => (
            <li id={release.anchor} class="scroll-mt-20 rounded-lg border bg-card p-6">
              <div class="flex flex-wrap items-center gap-2">
                <a href={release.href} class="font-mono text-sm font-semibold hover:text-accent">
                  {release.library}
                </a>
                <span class="rounded-full border bg-secondary px-2 py-0.5 font-mono text-[0.7rem] text-subtle">
                  v{release.version}
                </span>
                {release.bump && (
                  <span
                    class:list={[
                      "rounded-full border px-2 py-0.5 text-[0.7rem] font-medium",
                      BUMP_STYLES[release.bump] ?? BUMP_STYLES.patch,
                    ]}
                  >
                    {release.bump}
                  </span>
                )}
                <time datetime={release.date.toISOString()} class="ml-auto text-xs text-subtle">
                  {formatDate(release.date)}
                </time>
              </div>
              {release.items.length > 0 && (
                <ul class="mt-4 space-y-2">
                  {release.items.map((item) => (
                    <li class="flex gap-2.5 text-sm text-muted-foreground">
                      <span class="mt-1.5 size-1 shrink-0 rounded-full bg-accent" />
                      <span set:html={inlineMd(item)} />
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
