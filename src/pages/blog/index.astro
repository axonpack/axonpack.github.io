---
import BaseLayout from "@/layouts/base.layout.astro";
import SiteHeader from "@/components/site-header.component.astro";
import SiteFooter from "@/components/site-footer.component.astro";
import Icon from "@/components/ui/icon.ui.astro";
import { getPosts, getReleases } from "@/lib/services/blog-entries.service";
import { formatDate } from "@/lib/utils/format-date.util";

const posts = await getPosts();
const releaseCount = getReleases().length;
---

<BaseLayout
  title="Blog · Axonpack Open Source"
  description="Writing about the Axonpack libraries for React and React Native. Release notes live in the changelog."
>
  <SiteHeader />
  <main class="px-5 py-20">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-[clamp(2rem,1.4rem+2vw,3rem)] font-[640] leading-tight tracking-[-0.03em]">
        Blog
      </h1>
      <p class="mt-4 text-pretty text-muted-foreground">
        Writing about the libraries and how they are built.
      </p>

      {
        posts.length === 0 ? (
          <div class="mt-12 rounded-lg border bg-card p-8 text-center">
            <p class="text-muted-foreground">
              Nothing written yet. There is a changelog though, and it is not short.
            </p>
            <a
              href="/blog/changelog/"
              class="mt-5 inline-flex h-11 items-center justify-center gap-2 rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground transition-all hover:-translate-y-px hover:shadow-lg"
            >
              Read the changelog
              <span class="rounded-full bg-primary-foreground/15 px-2 py-0.5 text-xs tabular-nums">
                {releaseCount}
              </span>
              <Icon name="arrow-right" class="size-4" />
            </a>
          </div>
        ) : (
          <ol class="mt-12 space-y-4">
            {posts.map((post) => (
              <li class="rounded-lg border bg-card p-6">
                <a href={post.href} class="group block">
                  <time datetime={post.date.toISOString()} class="text-xs text-subtle">
                    {formatDate(post.date)} · {post.author}
                  </time>
                  <h2 class="mt-2 text-lg font-semibold tracking-tight group-hover:text-accent">
                    {post.title}
                  </h2>
                  <p class="mt-2 text-sm text-muted-foreground">{post.description}</p>
                  <span class="mt-3 inline-flex items-center gap-1 text-sm text-accent">
                    Read <Icon name="arrow-right" class="size-3.5" />
                  </span>
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
