---
import BaseLayout from "@/layouts/base.layout.astro";
import Hero from "@/components/hero.component.astro";
import LibraryGrid from "@/components/library-grid.component.astro";
import Principles from "@/components/principles.component.astro";
import SiteFooter from "@/components/site-footer.component.astro";
import SiteHeader from "@/components/site-header.component.astro";
---

<BaseLayout
  title="Axonpack Open Source · Tools and libraries for React and React Native"
  description="Free, open source tools and libraries for React and React Native. Small, focused, dependency-light packages you drop in rather than a framework you adopt."
>
  <SiteHeader />
  <main>
    <Hero />
    <LibraryGrid />
    <Principles />
  </main>
  <SiteFooter />
</BaseLayout>
